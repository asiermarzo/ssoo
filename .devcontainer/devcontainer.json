{
    "name": "ssoo",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // strace, ltrace, gdb y valgrind necesitan ptrace y un seccomp sin restringir.
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.makefile-tools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "C_Cpp.default.cStandard": "c17"
            }
        }
    },

    // Comprobación al crear el contenedor: si algo falta, se ve en el log.
    "postCreateCommand": "gcc --version | head -1 && gdb --version | head -1 && strace --version 2>&1 | head -1 && tmux -V && valgrind --version",

    "remoteUser": "vscode"
}
